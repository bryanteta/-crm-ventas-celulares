{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lunivo-inventory",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "triggers": {"crons": ["*/5 * * * *"]},
  "durable_objects": {"bindings": [{"name": "CATALOG", "class_name": "CatalogStore"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["CatalogStore"]}]
}
